{%- comment -%}
  Kit Printer: the name and number boxes on a printable kit's product page, with a live preview of the back of the
  shirt. Shows only on products with a print price (metafield kit_printer.print_price). This is the friendly part;
  the real price and the real check run inside Shopify's checkout as Functions, so nothing here can be skipped
  to get a cheaper or a bad print.
{%- endcomment -%}
{%- assign print_price = product.metafields.kit_printer.print_price.value -%}
{%- comment -%} The preview uses the kit's own colours when the product has them (metafields kit_printer.shirt_colour
  and kit_printer.print_colour, type Color), and the block's settings otherwise. {%- endcomment -%}
{%- assign shirt_colour = product.metafields.kit_printer.shirt_colour.value | default: block.settings.shirt_colour -%}
{%- assign print_colour = product.metafields.kit_printer.print_colour.value | default: block.settings.ink_colour -%}
{%- if print_price and print_price > 0 -%}
  <div class="kp" data-kit-printer {{ block.shopify_attributes }}
       style="--kp-shirt: {{ shirt_colour }}; --kp-ink: {{ print_colour }};">
    <p class="kp__heading">
      {{ 'kit_printer.heading' | t }}
      <span class="kp__price">+{{ print_price | times: 100 | money }}</span>
    </p>

    <div class="kp__body">
      <svg class="kp__shirt" viewBox="130 120 740 790" role="img" aria-label="Preview of the back of the shirt">
        <path class="kp__cloth" d="M402 140 Q500 160 598 140 C650 150 700 158 732 176 L852 392 L764 448 L700 332 C694 420 690 520 690 600 C690 700 694 800 694 880 Q500 900 306 880 C306 800 310 700 310 600 C310 520 306 420 300 332 L236 448 L148 392 L268 176 C300 158 350 150 402 140 Z"/>
        <path class="kp__shade" d="M268 176 L148 392 L236 448 L300 332 C292 262 282 214 268 176 Z M732 176 L852 392 L764 448 L700 332 C708 262 718 214 732 176 Z"/>
        <path class="kp__collar" d="M402 140 Q500 160 598 140"/>
        <text class="kp__name" x="500" y="292" text-anchor="middle" data-kp-name-out></text>
        <text class="kp__number" x="500" y="640" text-anchor="middle" data-kp-number-out></text>
      </svg>

      <div class="kp__fields">
        <label class="kp__label">{{ 'kit_printer.name' | t }}
          <input class="kp__input" type="text" name="properties[Print name]" maxlength="12"
                 autocomplete="off" autocapitalize="characters" spellcheck="false" data-kp-name>
        </label>
        <label class="kp__label">{{ 'kit_printer.number' | t }}
          <input class="kp__input" type="text" name="properties[Print number]" maxlength="2"
                 inputmode="numeric" autocomplete="off" data-kp-number>
        </label>
        <p class="kp__hint">{{ 'kit_printer.hint' | t }}</p>
        <p class="kp__error" role="alert" aria-live="polite" data-kp-error hidden></p>
      </div>
    </div>
  </div>

  <link rel="stylesheet" href="{{ 'kit-printer.css' | asset_url }}">
  <script type="module" src="{{ 'kit-printer.js' | asset_url }}"></script>
{%- endif -%}

{% schema %}
{
  "name": "Kit Printer",
  "target": "section",
  "settings": [
    { "type": "color", "id": "shirt_colour", "label": "Shirt colour in the preview (when the product has none)", "default": "#c8102e" },
    { "type": "color", "id": "ink_colour", "label": "Print colour in the preview (when the product has none)", "default": "#ffffff" }
  ]
}
{% endschema %}
